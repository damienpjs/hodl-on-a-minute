# Copy to .env.local and fill in. Never commit the filled-in file: this repo is public.

# AWS — use a dedicated IAM user whose policy is limited to GetItem / PutItem /
# UpdateItem on the single table below.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=hodl-on-a-minute-players

# Local development only — leave empty (or omit) to talk to the real AWS.
#
#   docker run -d -p 8000:8000 --name hodl-ddb amazon/dynamodb-local
#   DYNAMODB_ENDPOINT=http://localhost:8000
#
# DynamoDB Local accepts any credentials but partitions its data by access key
# and region, so keep AWS_ACCESS_KEY_ID and AWS_REGION stable between runs or
# your table appears to vanish.
DYNAMODB_ENDPOINT=

# Signs the httpOnly player-identity cookie. Any long random string:
#   openssl rand -base64 32
COOKIE_SECRET=

# Binance needs no key for the public endpoints this app uses
# (/api/v3/ticker/price and /api/v3/klines).

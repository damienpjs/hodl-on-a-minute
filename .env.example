# Copy to .env.local and fill in. Never commit the filled-in file: this repo is public.

# AWS — use a dedicated IAM user whose policy is limited to GetItem / PutItem /
# UpdateItem on the single table below.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=hodl-on-a-minute-players

# Signs the httpOnly player-identity cookie. Any long random string:
#   openssl rand -base64 32
COOKIE_SECRET=

# Binance needs no key for the public endpoints this app uses
# (/api/v3/ticker/price and /api/v3/klines).
